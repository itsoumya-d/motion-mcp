{
  "name": "@motion-mcp/generation-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Generation engine: deterministic natural-language motion intent parsing and temperament-driven procedural clip synthesis (overshoot, squash/stretch, secondary motion) into schema-valid SceneDocs.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@motion-mcp/critic": "workspace:*",
    "@motion-mcp/scene-graph": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsoumya-d/motion-mcp.git",
    "directory": "packages/generation-engine"
  },
  "homepage": "https://github.com/itsoumya-d/motion-mcp#readme",
  "bugs": {
    "url": "https://github.com/itsoumya-d/motion-mcp/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
