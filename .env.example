# Motion MCP environment reference. Everything here is optional — the server
# runs fully local and deterministic with zero configuration.

# ── Server ─────────────────────────────────────────────────────────────────
# Default project root when a tool call omits rootPath.
MOTION_MCP_ROOT=
# Set to expose the HTTP tool bridge (e.g. 7860). Unset = stdio only.
MOTION_MCP_HTTP_PORT=
# Bind host for the bridge. Keep 127.0.0.1 locally; use 0.0.0.0 in containers.
MOTION_MCP_HTTP_HOST=127.0.0.1
# Bearer token required on every bridge call when set. REQUIRED before
# exposing the bridge beyond localhost.
MOTION_MCP_HTTP_TOKEN=
# Per-client requests per minute on the bridge. 0 disables the limiter.
MOTION_MCP_HTTP_RATE_LIMIT_PER_MIN=60
# Starting credit balance for new workspaces (default 500).
MOTION_MCP_INITIAL_CREDITS=

# ── Premium asset lane (optional) ──────────────────────────────────────────
# QuiverAI structured-SVG generation. Unset = simple lane only.
QUIVERAI_API_KEY=
QUIVERAI_API_KEYS=
QUIVERAI_BASE_URL=
# Force the deterministic Quiver mock regardless of keys.
MOTION_MCP_QUIVER_MOCK=

# ── Live vision judge (optional) ───────────────────────────────────────────
# Without these, the critic uses the deterministic offline mock judge.
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
MOTION_MCP_GEMINI_MODEL=
MOTION_MCP_CLAUDE_MODEL=

# ── Billing links (optional; shown by purchase_credits_url) ───────────────
MOTION_MCP_STRIPE_CHECKOUT_URL=
MOTION_MCP_STRIPE_PORTAL_URL=
